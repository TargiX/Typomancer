# Optional server-side key for Vercel/local server runtimes.
# Never use a VITE_ prefix for secrets; Vite exposes those to browser bundles.
GEMINI_API_KEY=your_key_here

# Optional public anonymous analytics configuration. These values are safe to expose.
VITE_POSTHOG_KEY=your_public_project_token
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional cloud saves. Browser uses same-origin /api/auth and /api/progress.
VITE_CLOUD_PROGRESS=false
# Local-only Vite proxy to the independently launched progress API.
PROGRESS_API_URL=

# Backend container ONLY. Never prefix any of these with VITE_.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://typomancer.xyz
AUTH_TRUSTED_ORIGINS=https://www.typomancer.xyz
