# Optional server-side key for Vercel/local server runtimes.
# Never use a VITE_ prefix for secrets; Vite exposes those to browser bundles.
GEMINI_API_KEY=your_key_here

# Optional public anonymous analytics configuration. These values are safe to expose.
VITE_POSTHOG_KEY=your_public_project_token
VITE_POSTHOG_HOST=https://us.i.posthog.com
